# Copy this file to .env and fill in real values. Never commit .env.

# Session
SESSION_SECRET=change-this-to-a-long-random-string

# --- Admin login (AWS Cognito) ---
# Admins log in with a username/password checked against a Cognito User Pool.
# See README.md "Admin authentication (AWS Cognito)" for setup steps.
COGNITO_REGION=us-west-2
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Only needed if the app client was created WITH a client secret.
COGNITO_CLIENT_SECRET=

# AdminInitiateAuth (used above) requires AWS credentials, not just a
# Cognito client ID. Locally, `aws configure` on your machine is usually
# enough and these can stay blank. On a server with no AWS CLI profile
# (see DEPLOYMENT.md step 2), set these explicitly.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Server
PORT=3000
NODE_ENV=development

# --- Database (SQLite) ---
# Events, RSVPs and mailing-list signups live in one SQLite file. Optional:
# the default is server/data/peninsula.db. Point this somewhere else (e.g. a
# folder outside the git checkout) if you want the data kept separate from the code.
DATABASE_PATH=
